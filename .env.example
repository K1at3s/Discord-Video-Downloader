DISCORD_TOKEN=bot_token_here
CHANNEL_IDS=
# 0 = sunucunun gerçek yükleme limitini kullan (en fazla 500 MB).
# 0'dan büyük değer, tüm sunucularda geçerli bir üst sınır (MB) koyar.
MAX_UPLOAD_MB=0
YTDLP_REMOTE_EJS=0
MAX_LINKS_PER_MESSAGE=3
MAX_CONCURRENT_JOBS=2
# Slash komutlarının hemen görünmesi için test sunucusu ID'si (boş = global).
COMMAND_GUILD_ID=
# ! komutları için kullanıcı başı bekleme süresi (saniye). 0 = kapalı.
COMMAND_COOLDOWN_SECONDS=2
# Boş = son başarılı sağlayıcının ölçülen p95 süresine göre uyarlanır (3-20 sn).
# Sabit bir saniye değeri yazarsanız o kullanılır. 0 = beklemeden hepsini başlat.
PROVIDER_HEDGE_SECONDS=
DATABASE_PATH=data/bot.sqlite3
COBALT_API_URL=
COBALT_API_KEY=
COOKIE_FILE=
# Netscape cookie jar or a raw single-line "Cookie:" header file for
# logged-in-only posts (Threads /share/ links, private accounts).
GALLERY_DL_RS_PATH=
# Instagram highlight (indown.io, çerezsiz, ~20/saat IP kotası) ayarları
HIGHLIGHT_CACHE_TTL_HOURS=12
HIGHLIGHT_CACHE_MAX_MB=512
HIGHLIGHT_HOURLY_LIMIT=4
HIGHLIGHT_DAILY_LIMIT=15
HIGHLIGHT_HEALTHCHECK_ENABLED=1
HIGHLIGHT_HEALTHCHECK_HOURS=24
HIGHLIGHT_HEALTHCHECK_RESERVE=3
# Genel medya önbelleği (aynı URL tekrarları için kısa süreli, disk)
MEDIA_CACHE_TTL_MINUTES=360
MEDIA_CACHE_MAX_MB=1024
# !stats / !panel komutlarını ve başka kullanıcının !info sorgusunu
# yalnızca bu Discord kullanıcı ID'si kullanabilir.
STATS_OWNER_ID=1065352859195015260
# İşlem kayıtlarının saklanma süresi (gün)
REQUEST_LOG_RETENTION_DAYS=30
# 0 yapılırsa işlem kayıtlarında URL saklanmaz (platform/sonuç yine tutulur)
REQUEST_LOG_STORE_URL=1
# Bakım modu: 1/0. Boş bırakılırsa son durum data/maintenance.json'dan okunur.
# Discord içinden: !bakim ac / !bakim kapat
MAINTENANCE_MODE=
# Bakım açıkken gösterilecek özel mesaj (opsiyonel)
MAINTENANCE_MESSAGE=
# --- Operasyon ---
# Konsol + dönen dosya günlüğü. Boş/0 = yalnızca konsol. 10 MB x 7 dosya.
LOG_FILE=data/bot.log
LOG_LEVEL=INFO
# Yerel sağlık uç noktası: /healthz. 0 = kapalı (varsayılan).
HEALTH_HOST=127.0.0.1
HEALTH_PORT=0
# Günlük SQLite yedeği (data/backups/<tarih>/). 0 = kapalı.
BACKUP_ENABLED=1
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
